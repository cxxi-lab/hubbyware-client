{
	"name": "@hub/app",
	"private": true,
	"version": "0.0.0",
	"type": "module",
	"description": "Shared hub React UI, consumed by the desktop (Electron) and mobile (Capacitor) shells.",
	"exports": {
		"./platform": "./src/platform/types.ts"
	},
	"scripts": {
		"typecheck": "tsc --noEmit && tsc -p ../packages/hubbyware-sdk",
		"check:boundaries": "node scripts/check-boundaries.mjs",
		"build": "vite build",
		"build:mobile": "vite build",
		"types:sdk": "node scripts/emit-sdk-types.mjs",
		"test:crypto": "esbuild src/core/crypto/files.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=build/test/files.test.mjs --log-level=warning && node --test build/test/files.test.mjs",
		"test:tasks": "esbuild src/core/api/tasks.test.ts --bundle --platform=node --define:import.meta.env='{\"DEV\":false}' --banner:js='globalThis.window={api:{platform:\"linux\",versions:{}}};' --format=esm --tsconfig=tsconfig.json --outfile=build/test/tasks.test.mjs --log-level=warning && node --test build/test/tasks.test.mjs",
		"test:apis": "esbuild src/core/hubby/apis.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=build/test/apis.test.mjs --log-level=warning && node --test build/test/apis.test.mjs",
		"test:sync": "esbuild src/core/sync/sync.test.ts --bundle --platform=node --format=esm --tsconfig=tsconfig.json --outfile=build/test/sync.test.mjs --log-level=warning && node --test build/test/sync.test.mjs"
	},
	"dependencies": {
		"@capacitor/core": "^8.5.3",
		"@cxxi-lab/hubbyware-sdk": "^4.0.0",
		"@cxxi-lab/hubbyware-ui": "^0.7.0",
		"@fortawesome/fontawesome-svg-core": "^7.2.0",
		"@fortawesome/free-brands-svg-icons": "^7.2.0",
		"@fortawesome/free-regular-svg-icons": "^7.2.0",
		"@fortawesome/free-solid-svg-icons": "^7.2.0",
		"@fortawesome/react-fontawesome": "^3.3.1",
		"@noble/ciphers": "2.4.0",
		"@noble/hashes": "2.4.0",
		"jsqr": "1.4.0",
		"qrcode": "1.5.4",
		"react": "^19.2.4",
		"react-dom": "^19.2.4",
		"react-router": "^7.18.3",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.2.2"
	},
	"devDependencies": {
		"@tailwindcss/vite": "^4.3.0",
		"@types/qrcode": "1.5.6",
		"@types/react": "^19.2.14",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^5.2.0",
		"dts-bundle-generator": "^9.5.1",
		"tailwind-scrollbar": "^4.0.2",
		"tailwindcss": "^4.3.0",
		"typescript": "^5.3.3",
		"vite": "^7.3.1",
		"vite-plugin-svgr": "^5.2.0"
	}
}
