{
	"name": "hub-desktop",
	"private": true,
	"version": "0.151.0",
	"description": "hub, the desktop app",
	"homepage": "https://hubbyware.cxxi.io",
	"repository": {
		"type": "git",
		"url": "https://github.com/cxxi-lab/hubbyware-client.git",
		"directory": "desktop"
	},
	"type": "module",
	"main": "out/main/index.js",
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"start": "electron-vite preview",
		"pack": "electron-vite build && electron-builder --dir",
		"dist": "electron-vite build && electron-builder",
		"lint": "eslint src --ext .ts,.tsx",
		"clean": "rm -rf out dist node_modules"
	},
	"devDependencies": {
		"electron": "42.11.18",
		"electron-builder": "^26.16.1",
		"electron-vite": "^4.0.0",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"prettier": "^3.2.4",
		"typescript": "^5.3.3"
	},
	"dependencies": {
		"@cxxi-lab/hubbyware-sdk": "^4.0.0",
		"electron-updater": "^6.8.9",
		"onnxruntime-web": "^1.22.0"
	},
	"build": {
		"appId": "cxxi.hub",
		"productName": "Hubbyware",
		"directories": {
			"output": "dist"
		},
		"files": [
			"out/**/*",
			"!out/renderer/modules/*/**",
			"!out/renderer/modules/restricted.json",
			"package.json"
		],
		"extraResources": [
			{
				"from": "resources/icons",
				"to": "icons",
				"filter": [
					"**/*"
				]
			}
		],
		"linux": {
			"target": [
				"AppImage"
			],
			"category": "Utility",
			"icon": "build/icons"
		},
		"publish": [
			{
				"provider": "generic",
				"url": "https://hubbyware.cxxi.io/releases/",
				"channel": "latest"
			}
		],
		"artifactName": "hubbyware-${version}.${ext}",
		"electronFuses": {
			"runAsNode": false,
			"enableNodeOptionsEnvironmentVariable": false,
			"enableNodeCliInspectArguments": false,
			"onlyLoadAppFromAsar": true,
			"loadBrowserProcessSpecificV8Snapshot": false
		}
	}
}
